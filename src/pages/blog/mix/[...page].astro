---
export const prerender = false;
import { getCollection } from 'astro:content';
import { config } from "@/consts";
import Pagination from "@components/navigation/Pagination.astro";
import CardBlogWP from "@/components/common/CardBlogWP.astro";
import Layout from "@/layouts/Layout.astro";
// 1. Get Params
const pageParam = Astro.params.page;
const page = Number(Array.isArray(pageParam) ? pageParam[0] : pageParam) || 1;
const perPage = config.NUM_POSTS_ON_MIX;

// 2. Fetch Local Markdown/MDX Posts (Content Collections)
const localPostsRaw = await getCollection('blog');

// Normalize local posts to a unified structure
const localPosts = localPostsRaw.map((post) => ({
  id: post.id,
  title: post.data.title,
  pubDate: new Date(post.data.pubDate),
  link: `/blog/mix/${post.id}`,
  source: 'blog-collection',
  raw: post,
    image: post.data.heroImage || '/placeholder.jpg',
  slug: post.id,
  date: post.data.pubDate,
  excerpt: post.data.description
}));
// console.log('Local Posts:', localPostsRaw);

// 3. Fetch WordPress API Posts
// Note: Fetch all posts or enough pages if you want accurate combined pagination client-side
let wpPostsRaw = [];
try {
  const res = await fetch(`${config.WP_BLOG_LIST}&per_page=100`); // fetch a larger pool to sort correctly
  const data = await res.json();
  wpPostsRaw = Array.isArray(data) ? data : [];
} catch (e) {
  console.error('Failed to fetch WP posts:', e);
}

// Normalize WP posts to match the local posts structure
const wpPosts = wpPostsRaw.map((post) => ({
  id: post.id,
  title: post.title.rendered,
  pubDate: new Date(post.date),
  link: `/blog/mix/${post.slug}`,
  source: 'wordpress',
  raw: post,
  image: post._embedded?.['wp:featuredmedia']?.['0']?.media_details?.sizes?.full?.source_url  || '/placeholder.jpg',
  slug: post.slug,
  date: post.date,
  excerpt: post.excerpt.rendered
}));

// 4. Join and Sort Both Sources
const allPosts = [...localPosts, ...wpPosts].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()
);

// 5. Paginate the Combined Results
const totalPosts = allPosts.length;
const totalPages = Math.ceil(totalPosts / perPage);

const startIndex = (page - 1) * perPage;
const paginatedPosts = allPosts.slice(startIndex, startIndex + perPage);

// Pagination URLs
const url_prev = page > 1 ? `/blog/${page - 1}` : null;
const url_next = page < totalPages ? `/blog/${page + 1}` : null;

const title = "Blog";
const titleLayout = `Blog — Page ${page}`;
//const description = "Blogs fetched from WordPress CMS (on demand).";
const description = "Blogs";
---
<Layout title={titleLayout} description={description} isDynamic={true} maxWidth={true}>
  <section class=" text-center bg-grid p-5">
    <div class="flex flex-wrap gap-y-2 items-center justify-center p-5">
      <h1 class="text-lg font-semibold">{description}</h1>
    </div>

	<div class="grid gap-8 grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4  2xl:grid-cols-4">  
      {paginatedPosts.map(post => (
        <CardBlogWP
          url={`/blog/mix/${post.slug}/`}
          image={post.image}
          title={post.title}
          slug={post.slug}
          date={post.date}
          excerpt={post.excerpt}
        />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination
      totalPages={totalPages}
      currentPage={page}
      baseUrl="/blog/mix"
    />
  </section>
</Layout>